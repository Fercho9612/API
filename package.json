{
  "name": "api-peliculas-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  }
}

  "devDependencies": {
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
